# 应用主库 (Prisma, Phase 1 仍为 SQLite)
DATABASE_URL="file:./dev.db"

# iThink / MiniMax 模型配置
ITHINK_API_KEY=""
ITHINK_BASE_URL="https://api.minimaxi.com/anthropic"
ITHINK_IMAGE_MODEL="gpt-image-2"
ITHINK_CHAT_MODEL="MiniMax-M3"
ITHINK_TEXT_API_KEY=""

# Session / 签名密钥
APP_SECRET="change-me-in-production"

# 千川数据快照 — 临时仓用本地 MySQL (Phase 2 切统一 MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=oceanengine_api

# OceanEngine API 限速 (QPS); 默认 10
OCEANENGINE_QPS=10
