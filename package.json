{
  "name": "ai-commerce-image-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "typecheck": "tsc --noEmit",
    "db:push": "node prisma/init.mjs && prisma generate",
