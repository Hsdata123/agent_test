generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  nickname     String
  passwordHash String
  role         String     @default("creator")
  status       String     @default("active")
  departmentId String?
  advertiserId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?

  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projects     Project[]          @relation("ProjectCreator")
  memberships  ProjectMember[]
  assets       KnowledgeAsset[]
  parses       MechanismParse[]
  tasks        GenerationTask[]
  sessions     Session[]
  skills       Skill[]
  advertiserBindings UserAdvertiserBinding[]
}

model UserAdvertiserBinding {
  id           String   @id @default(cuid())
  userId       String
  advertiserId String
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, advertiserId])
  @@index([userId])
  @@index([advertiserId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  coverUrl    String?
  creatorId   String
  status      String        @default("active")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  creator User               @relation("ProjectCreator", fields: [creatorId], references: [id])
  members ProjectMember[]
  parses  MechanismParse[]
  tasks   GenerationTask[]
  results GenerationResult[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("viewer")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model KnowledgeAsset {
  id             String       @id @default(cuid())
  assetName      String
  originalName   String
  assetType      String
  productName    String?
  tags           String       @default("[]")
  aliases        String       @default("[]")
  description    String?
  storagePath    String
  mimeType       String?
  enabled        Boolean      @default(true)
  preferred      Boolean      @default(false)
  vectorStatus   String       @default("pending")
  extractedText  String?
  departmentId   String?
  scenes         String       @default("[]")
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  createdBy User              @relation(fields: [createdById], references: [id])
  department Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  aliasesRel ProductAlias[]
  items     MechanismItem[]
}

model ProductAlias {
  id        String   @id @default(cuid())
  alias     String
  assetId   String
  createdAt DateTime @default(now())

  asset KnowledgeAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([alias, assetId])
}

model MechanismParse {
  id             String   @id @default(cuid())
  projectId      String
  rawMechanism   String
  price          Float
  productSummary String
  parseStatus    String   @default("success")
  errorMessage   String?
  createdById    String
  createdAt      DateTime @default(now())

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id])
  items   MechanismItem[]
  tasks   GenerationTask[]
}

model MechanismItem {
  id             String    @id @default(cuid())
  parseId        String
  productName    String
  quantity       Int       @default(1)
  matchedAssetId String?
  matchType      String    @default("none")
  matchScore     Float     @default(0)

  parse        MechanismParse  @relation(fields: [parseId], references: [id], onDelete: Cascade)
  matchedAsset KnowledgeAsset? @relation(fields: [matchedAssetId], references: [id])
}

model GenerationTask {
  id              String     @id @default(cuid())
  projectId       String
  parseId         String
  createdById     String
  outputType      String
  aspectRatio     String
  detailPageCount Int?
  imageCount      Int        @default(1)
  templateAssetId String?
  imageSize       String?
  imageQuality    String?
  prompt          String?
  status          String     @default("queued")
  failureReason   String?
  knowledgeEnhanced Boolean  @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parse   MechanismParse     @relation(fields: [parseId], references: [id], onDelete: Cascade)
  creator User               @relation(fields: [createdById], references: [id])
  results GenerationResult[]
}

model GenerationResult {
  id          String   @id @default(cuid())
  taskId      String
  projectId   String
  imagePath   String
  pageIndex   Int?
  width       Int?
  height      Int?
  prompt      String?
  createdAt   DateTime @default(now())

  task    GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ApiConfig {
  id             String   @id @default("singleton")
  textBaseUrl    String   @default("https://api.minimaxi.com/anthropic")
  textModel      String   @default("MiniMax-M3")
  textWireApi    String   @default("anthropic")
  textPromptCacheEnabled Boolean @default(true)
  textPromptCacheRetention String @default("24h")
  textPromptCacheKey String @default("commerce-chat")
  disableResponseStorage Boolean @default(true)
  imageBaseUrl   String   @default("https://token.ithinkai.cn/v1")
  imageModel     String   @default("gpt-image-2")
  embeddingModel String   @default("text-embedding-3-small")
  maxConcurrency Int      @default(1)
  retryCount     Int      @default(2)
  timeoutSeconds Int      @default(240)
  updatedAt      DateTime @updatedAt
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?  @unique
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users  User[]
  scenes BusinessScene[]
  assets KnowledgeAsset[]
  skills Skill[]
}

model BusinessScene {
  id           String   @id @default(cuid())
  departmentId String
  sceneKey     String
  sceneName    String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, sceneKey])
}

model Skill {
  id            String    @id @default(cuid())
  name          String    @unique
  displayName   String
  description   String
  parameters    String    @default("{\"type\":\"object\",\"properties\":{},\"required\":[]}")
  executeMode   String    @default("search_kb")
  executeConfig String    @default("{}")
  systemPrompt  String?
  enabled       Boolean   @default(true)
  departmentId  String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([deletedAt])
}

model QianchuanToken {
  id                  String    @id @default(cuid())
  appId               String    @unique
  appSecret           String
  accessToken         String
  refreshToken        String
  accessTokenExpireAt DateTime
  refreshTokenExpireAt DateTime
  scope               String?
  lastRefreshAt       DateTime?
  lastError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  advertisers         QianchuanAdvertiser[]
}

model QianchuanAdvertiser {
  id            String         @id @default(cuid())
  tokenId       String
  advertiserId  String
  nickname      String?
  createdAt     DateTime       @default(now())

  token         QianchuanToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([tokenId, advertiserId])
  @@index([advertiserId])
}

model QianchuanAnchor {
  id            String         @id @default(cuid())
  advertiserId  String
  anchorId      String
  anchorName    String
  nickname      String?
  lastSeenAt    DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([advertiserId, anchorId])
  @@index([advertiserId, anchorName])
}
